<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetDockButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/dock_button_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="EinkButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/eink_fg</item>
        <item name="strokeColor">@color/eink_fg</item>
        <item name="rippleColor">@color/eink_muted</item>
    </style>
</resources>
