<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/slot_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/slot_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/slot_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eink_fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slot_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_move_up"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dock_move_up"
            android:src="@android:drawable/arrow_up_float" />

        <ImageButton
            android:id="@+id/btn_move_down"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dock_move_down"
            android:src="@android:drawable/arrow_down_float" />
    </LinearLayout>
</LinearLayout>
