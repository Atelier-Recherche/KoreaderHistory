<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.EinkLauncher">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LauncherSettingsActivity" android:exported="false" />
        <activity android:name=".LauncherDockEditorActivity" android:exported="false" />
        <activity android:name=".LauncherDockSlotEditActivity" android:exported="false" />
        <activity android:name=".WidgetPickerActivity" android:exported="false" />
        <activity android:name=".AppDrawerActivity" android:exported="false" />
        <activity android:name=".IconPickerActivity" android:exported="false" />
        <activity android:name=".FolderActivity" android:exported="false" />

        <activity
            android:name=".TaskBarActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.EinkLauncher.Transparent" />

        <activity
            android:name=".AltTabActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance" />

        <activity
            android:name=".RunLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateVisible" />

        <activity android:name=".NotificationPanelActivity" android:exported="false" />

        <service
            android:name=".HotkeyAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hotkey_accessibility_service" />
        </service>

        <service
            android:name=".EinkNotificationListener"
            android:exported="true"
            android:label="@string/notifications_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
