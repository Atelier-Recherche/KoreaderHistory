<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/eink_bg"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/widget_chrome_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/eink_fg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_widget_smaller"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="−"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_widget_larger"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="+"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_widget_remove"
            style="@style/EinkButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/widget_remove"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_host_slot"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/eink_bg" />
</LinearLayout>
